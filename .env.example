# docker-compose 가 읽는 루트 환경 파일. 복사해서 .env 로 쓴다.
#   cp .env.example .env
# .env 는 .gitignore 에 있다 — 절대 커밋하지 않는다.

# ── LLM ────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# 사규 검색 경로 기준. 더 어려운 작업이 붙으면 claude-opus-5 로 올린다.
ANTHROPIC_MODEL=claude-sonnet-5
# low | medium | high | xhigh | max
# ⚠ Sonnet 5 에서 low 는 근거를 얕게 읽을 수 있다 (config.py 주석 참조).
ANTHROPIC_EFFORT=medium

# ── 임베딩 ──────────────────────────────────────────
# 색인·질의에 쓰는 정밀도. float16 | float32
#
#   float16  가중치가 절반(1.1GB). 메모리가 좁은 곳(WSL 4GB)에서 산다
#   float32  CPU 에서 훨씬 빠르다 — CPU 에는 fp16 연산 유닛이 없어 에뮬레이션으로
#            돌기 때문이다. 실측: 문서 하나(청크 11개)에 fp16 4분 40초
#
# ⚠ 바꾸면 뇌 재기동 + 전체 재색인이 함께 가야 한다. 색인된 벡터와 질의 벡터의
#   정밀도가 다르면 미세하게 어긋난다.
EMBED_DTYPE=float16

# ── DB ─────────────────────────────────────────────
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=geniein_db
DB_PORT=5432

# ── 서비스 ──────────────────────────────────────────
AGENT_PORT=8000
LOG_LEVEL=INFO

# ── 인격 ────────────────────────────────────────────
# 테넌트(Entra tid) → 인격 파일. `tid:키` 를 쉼표로 잇는다. 키는 곧
# apps/agent-service/personas/{키}.yaml 이다.
#
#   지니   personas/default.yaml   지니비나. 매핑이 없는 테넌트의 기본값이다
#   마이키 personas/aqv.yaml       AQV(AirQuay Vina)
#
# ★ tid 는 apps/api/.env 의 ENTRA_ALLOWED_TENANTS 에 있는 값과 같은 것을 쓴다.
#   여기 없는 테넌트는 지니 인격으로 답한다 (요청이 막히지는 않는다. 기동 로그와
#   첫 요청의 WARNING 을 보면 매핑 누락이 보인다).
# ★ 매핑에 적었는데 그 인격 파일이 없으면 뇌가 기동하지 않는다 — 배포 누락은
#   조용히 넘어가면 안 되기 때문이다.
#
#   PERSONA_ORG_MAP=<지니 tid>:default,<AQV tid>:aqv
#
# 지니 테넌트를 `:default` 로 적어두는 것을 권한다. 안 적어도 동작은 같지만,
# 적어두면 첫 요청의 "매핑된 인격이 없다" 경고가 진짜 모르는 테넌트에서만 뜬다.
PERSONA_ORG_MAP=

# ── 서비스 간 인증 ──────────────────────────────────
# NestJS(게이트웨이) → agent-service(뇌) 호출용 공유 토큰.
# 비어 있으면 뇌가 모든 요청을 503 으로 막는다 (설정 누락은 "인증 없음"이 아니다).
# apps/api/.env 의 ADMIN_SERVICE_TOKEN 과 **다른 값**을 쓴다 — 경계가 다르면 토큰도 다르다.
#   openssl rand -base64 32
AGENT_SERVICE_TOKEN=
