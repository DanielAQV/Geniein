# docker-compose 가 읽는 루트 환경 파일. 복사해서 .env 로 쓴다.
#   cp .env.example .env
# .env 는 .gitignore 에 있다 — 절대 커밋하지 않는다.

# ── LLM ────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

# ── DB ─────────────────────────────────────────────
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=geniein_db
DB_PORT=5432

# ── 서비스 ──────────────────────────────────────────
AGENT_PORT=8000
LOG_LEVEL=INFO

# ── 서비스 간 인증 ──────────────────────────────────
# NestJS(게이트웨이) → agent-service(뇌) 호출용 공유 토큰.
# 비어 있으면 뇌가 모든 요청을 503 으로 막는다 (설정 누락은 "인증 없음"이 아니다).
# apps/api/.env 의 ADMIN_SERVICE_TOKEN 과 **다른 값**을 쓴다 — 경계가 다르면 토큰도 다르다.
#   openssl rand -base64 32
AGENT_SERVICE_TOKEN=
