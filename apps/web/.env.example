# apps/web 환경변수. 복사해서 .env 로 쓴다 — .env 는 절대 커밋하지 않는다.
#   cp apps/web/.env.example apps/web/.env

# ── 관리자 인증 (Phase 0 브리지) ─────────────────────
# ★ 이 셋은 Entra ID SSO 도입 시 사라진다. 그때까지의 임시 자격증명이다.
#
# 아래 명령이 ADMIN_PASSWORD_HASH 와 AUTH_SECRET 을 한 번에 만들어 준다:
#   node apps/web/scripts/hash-password.mjs '실제비밀번호'
#
# 세션 쿠키 서명 키. 32자 이상. 바꾸면 기존 세션이 전부 무효가 된다.
AUTH_SECRET=
# 관리자 계정. 평문 비밀번호는 어디에도 저장하지 않는다.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# ── API 연결 ────────────────────────────────────────
# 브라우저가 직접 부르는 공개 API. 이 값이 다른 오리진이면
# next.config.mjs 가 CSP connect-src 에 자동으로 추가한다.
NEXT_PUBLIC_API_URL=http://localhost:3001
# BFF(서버→서버)가 쓰는 내부 주소. 비우면 NEXT_PUBLIC_API_URL 을 쓴다.
API_INTERNAL_URL=http://localhost:3001
# NestJS 관리자 엔드포인트 호출용 공유 토큰. apps/api/.env 의 같은 값과 일치해야 한다.
# ⚠ NEXT_PUBLIC_ 접두어를 붙이지 말 것 — 브라우저 번들로 나간다.
#   openssl rand -base64 32
ADMIN_SERVICE_TOKEN=

# ── 문의 폼 (Resend) ────────────────────────────────
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=onboarding@resend.dev
