{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "${APP_VERSION}",
  "id": "${ENTRA_CLIENT_ID}",
  "developer": {
    "name": "AirQuay Vina",
    "websiteUrl": "${WEBSITE_URL}",
    "privacyUrl": "${PRIVACY_URL}",
    "termsOfUseUrl": "${TERMS_URL}"
  },
  "name": {
    "short": "사규검색",
    "full": "유나 — 사내 규정 검색"
  },
  "description": {
    "short": "사내 규정을 평소 말하듯 물어보고 근거와 함께 답을 받습니다.",
    "full": "출장비·수당·근태 같은 사내 규정을 자연어로 물어보면, 근거가 된 문서명·조항·시행일과 함께 답변합니다. 회사 계정으로 자동 로그인되며, 본인이 속한 법인의 규정만 검색됩니다."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#02040A",
  "staticTabs": [
    {
      "entityId": "yuna-search",
      "name": "사규검색",
      "contentUrl": "${CONTENT_HOST}/teams/search",
      "websiteUrl": "${CONTENT_HOST}/teams/search",
      "scopes": ["personal"]
    }
  ],
  "permissions": ["identity"],
  "validDomains": ["${CONTENT_DOMAIN}"],
  "webApplicationInfo": {
    "id": "${ENTRA_CLIENT_ID}",
    "resource": "${ENTRA_API_AUDIENCE}"
  }
}
