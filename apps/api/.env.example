# apps/api 환경변수. 복사해서 .env 로 쓴다 — .env 는 절대 커밋하지 않는다.
#   cp apps/api/.env.example apps/api/.env

# ── DB ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=geniein_db

# ── 서버 ───────────────────────────────────────────
PORT=3001

# ── CORS ───────────────────────────────────────────
# 쉼표로 구분한 허용 오리진. 비우면 CORS 를 끈다(같은 오리진만 허용).
# ⚠ 와일드카드를 쓰지 않는다 — 예전 app.enableCors() 가 모든 오리진을 허용했다.
CORS_ORIGINS=http://localhost:3000

# ── 서비스 간 인증 ──────────────────────────────────
# /insights/admin 등 관리자 엔드포인트를 Next.js BFF 만 부를 수 있게 하는 공유 토큰.
# apps/web/.env 의 ADMIN_SERVICE_TOKEN 과 같은 값이어야 한다.
#   openssl rand -base64 32
ADMIN_SERVICE_TOKEN=

# ── AI (agent-service 연동. 현재 코드에서 미사용) ──────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium
RAG_SERVICE_URL=http://127.0.0.1:8000
AI_ALLOWED_IPS=
