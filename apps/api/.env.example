# apps/api 환경변수. 복사해서 .env 로 쓴다 — .env 는 절대 커밋하지 않는다.
#   cp apps/api/.env.example apps/api/.env

# ── DB ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=geniein_db

# ── 서버 ───────────────────────────────────────────
PORT=3001

# ── CORS ───────────────────────────────────────────
# 쉼표로 구분한 허용 오리진. 비우면 CORS 를 끈다(같은 오리진만 허용).
# ⚠ 와일드카드를 쓰지 않는다 — 예전 app.enableCors() 가 모든 오리진을 허용했다.
CORS_ORIGINS=http://localhost:3000

# ── 서비스 간 인증 ──────────────────────────────────
# /insights/admin 등 관리자 엔드포인트를 Next.js BFF 만 부를 수 있게 하는 공유 토큰.
# apps/web/.env 의 ADMIN_SERVICE_TOKEN 과 같은 값이어야 한다.
#   openssl rand -base64 32
ADMIN_SERVICE_TOKEN=

# ── AI (agent-service 연동. 현재 코드에서 미사용) ──────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_EFFORT=medium
RAG_SERVICE_URL=http://127.0.0.1:8000
AI_ALLOWED_IPS=

# ── agent-service(뇌) 호출용 ────────────────────────
# 루트 .env 의 AGENT_SERVICE_TOKEN 과 같은 값이어야 한다.
# ADMIN_SERVICE_TOKEN 과는 다른 값을 쓴다 — 경계가 다르면 토큰도 다르다.
AGENT_SERVICE_TOKEN=

# ── Zalo DM (지니 직원 대부분이 쓰는 채널) ───────────
# 봇은 https://bot.zaloplatforms.com 에서 만들고 토큰을 받는다. 문서: https://bot.zapps.me/docs
# 웹훅 공개 주소는 https://genie.geniein.com/zalo/webhook
# (deploy/nginx/genie.geniein.com.conf 의 `location = /zalo/webhook` → NestJS 3101).
# ★ geniein.com/api/ 쪽 NestJS(3001)가 아니다 — 거기엔 뇌 설정이 없다.
#   node scripts/zalo-bot.mjs set-webhook https://genie.geniein.com/zalo/webhook
ZALO_BOT_TOKEN=
# 웹훅 호출마다 Zalo 가 X-Bot-Api-Secret-Token 헤더로 보내는 값. 우리가 정해서 setWebhook 때 등록한다.
#   openssl rand -hex 24
ZALO_WEBHOOK_SECRET=
# Zalo 로 묻는 사람이 볼 수 있는 문서의 법인(= kb_documents.org_id = Entra tid). 지니 테넌트 id.
# 비우면 뇌를 부르지 않는다 — org 없는 검색은 필터가 없는 검색이다.
ZALO_ORG_ID=
# 기본값 https://bot-api.zapps.me . 테스트 때만 바꾼다.
# ZALO_API_BASE=

# ── Entra ID (Teams 탭 SSO) ─────────────────────────
# docs/TEAMS_TAB_DESIGN.md 3장 참조.
#
# ★ 앱 등록은 멀티테넌트 1개다. 그래서 clientId/audience 는 하나인데
#   발급 테넌트는 둘이고, 그 둘만 받아야 한다. 이 목록이 비면 가드가 503 으로
#   전부 막는다 — aud 만 보고 tid 를 안 보면 아무 Microsoft 테넌트나 통과한다.
#
# 쉼표 구분, 공백·주석 없이 tid 만. (에어키, 지니)
ENTRA_ALLOWED_TENANTS=
# Application (client) ID
ENTRA_CLIENT_ID=
# Application ID URI 를 그대로. 예: api://genie.geniein.com/<clientId>
ENTRA_API_AUDIENCE=

# ── 마이키 봇 채널 (선제 발신) ──────────────────────
# Azure Bot 리소스를 만들면 함께 생기는 앱 등록의 값이다.
#
# ★ 탭 SSO 의 ENTRA_CLIENT_ID 와 **다른 앱**이다. 봇은 인터넷에서 직접 두드려지는
#   표면이라, 자격증명을 탭과 공유하면 하나가 새는 순간 둘 다 샌다.
#
# 비어 있으면 봇 채널만 꺼지고 탭은 그대로 동작한다.
#
#   메시징 엔드포인트  https://genie.geniein.com/bot/messages
#   채널               Microsoft Teams 추가 필요
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
# 다중 테넌트 봇이다 — 등록은 geniein, 쓰는 곳은 AQV.
MICROSOFT_APP_TYPE=MultiTenant
# MultiTenant 에서는 비워 둔다 (SingleTenant 일 때만 채운다).
MICROSOFT_APP_TENANT_ID=

# Teams 매니페스트에 박히는 봇 ID. MICROSOFT_APP_ID 와 같은 값이다.
# 비어 있으면 apps/teams-app 빌드가 bots 블록 없이 나간다 (탭 전용 패키지).
BOT_APP_ID=
