# apps/api 환경변수. 복사해서 .env 로 쓴다 — .env 는 절대 커밋하지 않는다.
#   cp apps/api/.env.example apps/api/.env

# ── DB ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=geniein_db

# ── 서버 ───────────────────────────────────────────
PORT=3001

# ── CORS ───────────────────────────────────────────
# 쉼표로 구분한 허용 오리진. 비우면 CORS 를 끈다(같은 오리진만 허용).
# ⚠ 와일드카드를 쓰지 않는다 — 예전 app.enableCors() 가 모든 오리진을 허용했다.
CORS_ORIGINS=http://localhost:3000

# ── 서비스 간 인증 ──────────────────────────────────
# /insights/admin 등 관리자 엔드포인트를 Next.js BFF 만 부를 수 있게 하는 공유 토큰.
# apps/web/.env 의 ADMIN_SERVICE_TOKEN 과 같은 값이어야 한다.
#   openssl rand -base64 32
ADMIN_SERVICE_TOKEN=

# ── AI (agent-service 연동. 현재 코드에서 미사용) ──────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium
RAG_SERVICE_URL=http://127.0.0.1:8000
AI_ALLOWED_IPS=

# ── agent-service(뇌) 호출용 ────────────────────────
# 루트 .env 의 AGENT_SERVICE_TOKEN 과 같은 값이어야 한다.
# ADMIN_SERVICE_TOKEN 과는 다른 값을 쓴다 — 경계가 다르면 토큰도 다르다.
AGENT_SERVICE_TOKEN=

# ── Entra ID (Teams 탭 SSO) ─────────────────────────
# docs/TEAMS_TAB_DESIGN.md 3장 참조.
#
# ★ 앱 등록은 멀티테넌트 1개다. 그래서 clientId/audience 는 하나인데
#   발급 테넌트는 둘이고, 그 둘만 받아야 한다. 이 목록이 비면 가드가 503 으로
#   전부 막는다 — aud 만 보고 tid 를 안 보면 아무 Microsoft 테넌트나 통과한다.
#
# 쉼표 구분, 공백·주석 없이 tid 만. (에어키, 지니)
ENTRA_ALLOWED_TENANTS=
# Application (client) ID
ENTRA_CLIENT_ID=
# Application ID URI 를 그대로. 예: api://genie.geniein.com/<clientId>
ENTRA_API_AUDIENCE=
